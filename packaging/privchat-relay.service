[Unit]
Description=PrivChat onion relay node
Documentation=https://github.com/lipeilin2006/privchat
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=privchat-relay
Group=privchat-relay
EnvironmentFile=-/etc/privchat/relay.env
ExecStart=/usr/local/bin/privchat-relay
Restart=always
RestartSec=3
StateDirectory=privchat-relay
StateDirectoryMode=0700

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/privchat-relay

CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
