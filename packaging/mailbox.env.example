# PrivChat mailbox 节点环境变量（systemd 读取此文件）
# 改完 systemctl restart privchat-mailbox

# 数据目录（secret.key / mailbox.db / config.json）
PRIVCHAT_MAILBOX_DATA_DIR=/var/lib/privchat-mailbox

# 固定监听地址；公网部署建议开，并在云安全组/防火墙放行对应的 UDP 端口。
# 不设则随机端口，客户端只能靠 relay + 发现服务找到你。
PRIVCHAT_MAILBOX_BIND=0.0.0.0:8443

# both / mailbox / relay：both = 既存消息也做洋葱中继
PRIVCHAT_MAILBOX_ROLE=both

# 密文保留秒数；0 = 永不过期（不建议）
# PRIVCHAT_MAILBOX_TTL_SECS=604800

# 洋葱转发白名单（逗号分隔 peer_id），不设则不限制
# PRIVCHAT_MAILBOX_ONION_PEERS=
