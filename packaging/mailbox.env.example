# PrivChat 节点环境变量（systemd 读取此文件）
#
# 节点配置统一在 <data_dir>/config.json 里，这里只放「不方便进 json」的项，
# 或者想临时覆盖 json 的值。优先级：环境变量 > config.json > 默认值。

# 数据目录（secret.key / mailbox.db / config.json）
PRIVCHAT_MAILBOX_DATA_DIR=/var/lib/privchat-mailbox

# 下面这些通常写在 config.json 里，需要临时覆盖再取消注释：
# PRIVCHAT_MAILBOX_BIND=0.0.0.0:8443
# PRIVCHAT_MAILBOX_ROLE=both
# PRIVCHAT_MAILBOX_TTL_SECS=604800
# PRIVCHAT_MAILBOX_ONION_PEERS=
# PRIVCHAT_MAILBOX_MAX_QUEUE_MSGS=1000
# PRIVCHAT_MAILBOX_MAX_QUEUE_BYTES=67108864
# PRIVCHAT_MAILBOX_MAX_QUEUES=50000
